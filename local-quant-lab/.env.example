# Local Quant Lab needs no secrets. Nothing here is read by default.
# A future BROKER_PAPER adapter would read paper-account credentials from the environment, never from git.
# Leave these empty unless the founder explicitly opts in to a paper broker later.
BROKER_PAPER_API_KEY=
BROKER_PAPER_API_SECRET=

# Optional. Only if YOU obtained a Stooq API key on stooq.com. Export it in your shell; do not put a real value in git.
STOOQ_API_KEY=
