# Local Quant Lab credentials: names only. Copy to ~/.config/lql/env (preferred) or a .env in the repository root,
# fill in values there, then `chmod 600` it. Every .env is git-ignored; never commit real values (public repository).
# Read by lql/envfile.py: only these names, and a value already set in your environment always wins.
MASSIVE_API_KEY=
# yes = you have read Massive's current terms (needed for --refresh-data)
LQL_MASSIVE_TERMS_OK=
# Alpaca PAPER account only (key ids start with PK); used for read-only checks. No order route exists.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
# Optional context data
FRED_API_KEY=
BEA_API_USERID=
SEC_USER_AGENT=
# Quarantined source; leave empty
STOOQ_API_KEY=
