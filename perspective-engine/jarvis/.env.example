# Jarvis local agent: environment variable NAMES only. Never put real values in this file.
# Everything is optional; with none set, the agent runs on 127.0.0.1:7777 with ~/.jarvis and the rules-only answerer.
# To use a file: copy to .env (git-ignored), fill in non-secret settings, and start with `npm run jarvis:env`.
# Keep secrets out of files: export them from the macOS Keychain instead (see docs/JARVIS_SETUP.md, step 6).

# --- where and how it listens ---
# Private folder for token, config.json, tasks, memory, reminders, audit log (default ~/.jarvis).
JARVIS_HOME=
# Port on 127.0.0.1 (default 7777). The host is always 127.0.0.1; anything else is refused.
JARVIS_PORT=
# Only 127.0.0.1 is accepted; any other value stops the agent at start.
JARVIS_HOST=
# Bearer token for the API (at least 24 characters). Leave unset to use the generated ~/.jarvis/token (mode 0600).
JARVIS_TOKEN=

# --- project record ---
# Path to the exported Perspective Engine state (default ../city/public/state.json relative to this folder).
JARVIS_PE_STATE=

# --- language models (all optional; the rules answerer is always there) ---
# Ollama address (default http://127.0.0.1:11434; "host:port" also works).
OLLAMA_HOST=
# Pin an installed Ollama model, e.g. a tag you pulled yourself. Never pulled automatically.
JARVIS_OLLAMA_MODEL=
# Anthropic API key. Secret: export it from the Keychain, do not write it here.
ANTHROPIC_API_KEY=
# Anthropic model id for the API provider.
JARVIS_ANTHROPIC_MODEL=
# Set to 0 to ignore the `claude` CLI even when it is on PATH.
JARVIS_CLAUDE_CODE=
# Set to 1 to keep every open question on this Mac (Ollama and rules only).
JARVIS_LOCAL_ONLY=

# --- voice and browser ---
# Set to 0 so reminders show a notification without speaking.
JARVIS_SAY=
# Set to 0 to show the agent's browser window instead of running it headless.
JARVIS_BROWSER_HEADLESS=
# Where playwright-core finds its browsers (only if you installed them somewhere unusual).
PLAYWRIGHT_BROWSERS_PATH=
