{
  "name": "@pe/jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS for Perspective Engine: framework-free core, tests, and (later) the local Mac agent.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "jarvis": "tsx agent/src/main.ts",
    "agent:test": "vitest run agent",
    "jarvis:env": "tsx --env-file=.env agent/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "playwright-core": "1.56.1"
  }
}
